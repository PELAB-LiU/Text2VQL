<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes active="true" requires="//@regions.0/@sensors.0 //@regions.1/@sensors.1 //@regions.1/@sensors.2" entry="//@regions.0/@elements.1/@semaphores.0" exit="//@regions.0/@elements.1/@semaphores.0">
    <follows position="STRAIGHT" target="//@regions.0/@elements.2"/>
  </routes>
  <regions>
    <sensors monitors="//@regions.1/@elements.1 //@regions.0/@elements.0"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.0 //@regions.1/@sensors.0" connectsTo="//@regions.0/@elements.2"/>
    <elements xsi:type="Segment" connectsTo="//@regions.0/@elements.0">
      <semaphores signal="STOP"/>
    </elements>
    <elements xsi:type="Switch" monitoredBy="//@regions.1/@sensors.2" connectsTo="//@regions.0/@elements.3 //@regions.0/@elements.0" positions="//@routes.0/@follows.0"/>
    <elements xsi:type="Segment" connectsTo="//@regions.0/@elements.0"/>
  </regions>
  <regions>
    <sensors monitors="//@regions.1/@elements.1 //@regions.0/@elements.0"/>
    <sensors/>
    <sensors monitors="//@regions.0/@elements.2"/>
    <sensors/>
    <elements xsi:type="Segment" connectsTo="//@regions.0/@elements.3" length="-2"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.0 //@regions.1/@sensors.0" connectsTo="//@regions.0/@elements.0 //@regions.0/@elements.2" length="-5"/>
  </regions>
</RailwayContainer>
