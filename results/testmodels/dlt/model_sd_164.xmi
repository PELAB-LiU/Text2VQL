<?xml version="1.0" encoding="ASCII"?>
<dlt:RaftFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations>
    <hosts/>
    <hosts/>
  </organizations>
  <organizations/>
  <organizations>
    <hosts/>
    <hosts/>
  </organizations>
  <organizations>
    <hosts/>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.2"/>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.0"/>
      <nodes xsi:type="dlt:OrderingNode"/>
    </hosts>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.2/@chaincodes.0 //@channels.2/@chaincodes.1"/>
      <nodes xsi:type="dlt:OrderingNode"/>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.1"/>
      <nodes xsi:type="dlt:EndorsingNode"/>
    </hosts>
    <hosts/>
  </organizations>
  <channels orderedBy="//@organizations.3/@hosts.1/@nodes.1">
    <chaincodes/>
    <chaincodes/>
  </channels>
  <channels orderedBy="//@organizations.3/@hosts.2/@nodes.2"/>
  <channels orderedBy="//@organizations.3/@hosts.1/@nodes.0">
    <chaincodes endorsedBy="//@organizations.3/@hosts.2/@nodes.0"/>
    <chaincodes endorsedBy="//@organizations.3/@hosts.2/@nodes.0"/>
    <chaincodes/>
    <chaincodes/>
    <chaincodes/>
  </channels>
</dlt:RaftFabricNetwork>
