<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes active="true" requires="//@regions.1/@sensors.1" entry="//@regions.0/@elements.0/@semaphores.0" exit="//@regions.0/@elements.0/@semaphores.0">
    <follows position="STRAIGHT" target="//@regions.0/@elements.2"/>
  </routes>
  <regions>
    <sensors/>
    <sensors/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.1 //@regions.1/@sensors.0" connectsTo="//@regions.1/@elements.0">
      <semaphores signal="GO"/>
    </elements>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.2"/>
    <elements xsi:type="Switch" connectsTo="//@regions.0/@elements.0" currentPosition="STRAIGHT" positions="//@routes.0/@follows.0"/>
    <elements xsi:type="Segment" length="9"/>
  </regions>
  <regions>
    <sensors monitors="//@regions.0/@elements.0"/>
    <sensors monitors="//@regions.0/@elements.0 //@regions.1/@elements.0"/>
    <sensors monitors="//@regions.0/@elements.1 //@regions.1/@elements.1"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.1" connectsTo="//@regions.0/@elements.2 //@regions.0/@elements.1" length="98"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.2" connectsTo="//@regions.0/@elements.0" length="-9"/>
  </regions>
</RailwayContainer>
