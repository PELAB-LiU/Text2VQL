<?xml version="1.0" encoding="ASCII"?>
<dlt:KafkaFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode"/>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.0"/>
    </hosts>
    <hosts/>
  </organizations>
  <channels orderedBy="//@organizations.0/@hosts.0/@nodes.1"/>
  <channels>
    <chaincodes/>
    <chaincodes/>
    <chaincodes/>
    <chaincodes/>
    <chaincodes/>
  </channels>
  <channels>
    <chaincodes/>
  </channels>
  <channels>
    <chaincodes/>
    <chaincodes/>
    <chaincodes/>
    <chaincodes/>
  </channels>
</dlt:KafkaFabricNetwork>
