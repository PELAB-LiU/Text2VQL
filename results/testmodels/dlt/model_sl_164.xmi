<?xml version="1.0" encoding="ASCII"?>
<dlt:RaftFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.3"/>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.0 //@channels.2"/>
      <nodes xsi:type="dlt:OrderingNode"/>
    </hosts>
    <hosts/>
  </organizations>
  <organizations>
    <hosts/>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode"/>
      <nodes xsi:type="dlt:EndorsingNode"/>
      <nodes xsi:type="dlt:EndorsingNode"/>
      <nodes xsi:type="dlt:OrderingNode"/>
    </hosts>
  </organizations>
  <organizations/>
  <channels orderedBy="//@organizations.0/@hosts.0/@nodes.1"/>
  <channels/>
  <channels orderedBy="//@organizations.0/@hosts.0/@nodes.1"/>
  <channels orderedBy="//@organizations.0/@hosts.0/@nodes.0">
    <chaincodes/>
  </channels>
</dlt:RaftFabricNetwork>
