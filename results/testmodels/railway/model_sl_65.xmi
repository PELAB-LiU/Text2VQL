<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes requires="//@regions.0/@sensors.0" entry="//@regions.1/@elements.1/@semaphores.0" exit="//@regions.1/@elements.1/@semaphores.0">
    <follows position="STRAIGHT" target="//@regions.1/@elements.0"/>
  </routes>
  <regions>
    <sensors monitors="//@regions.1/@elements.2 //@regions.1/@elements.0"/>
    <elements xsi:type="Segment" length="-7"/>
    <elements xsi:type="Segment" length="-2"/>
  </regions>
  <regions>
    <sensors monitors="//@regions.1/@elements.1"/>
    <sensors monitors="//@regions.1/@elements.2"/>
    <elements xsi:type="Switch" monitoredBy="//@regions.0/@sensors.0" connectsTo="//@regions.0/@elements.0 //@regions.1/@elements.1" currentPosition="DIVERGING" positions="//@routes.0/@follows.0"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.0" connectsTo="//@regions.0/@elements.0 //@regions.1/@elements.0">
      <semaphores signal="GO"/>
    </elements>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.1 //@regions.0/@sensors.0" connectsTo="//@regions.1/@elements.0 //@regions.1/@elements.1" length="89"/>
  </regions>
  <regions>
    <sensors/>
    <sensors monitors="//@regions.2/@elements.0"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.2/@sensors.1" length="-1"/>
  </regions>
</RailwayContainer>
