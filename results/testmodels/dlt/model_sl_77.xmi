<?xml version="1.0" encoding="ASCII"?>
<dlt:KafkaFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations>
    <hosts/>
  </organizations>
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.4"/>
    </hosts>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.4/@chaincodes.0 //@channels.4/@chaincodes.2 //@channels.4/@chaincodes.1"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.4/@chaincodes.1 //@channels.4/@chaincodes.2"/>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.1"/>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.2 //@channels.3 //@channels.0"/>
    </hosts>
  </organizations>
  <channels orderedBy="//@organizations.1/@hosts.1/@nodes.3"/>
  <channels orderedBy="//@organizations.1/@hosts.1/@nodes.2"/>
  <channels orderedBy="//@organizations.1/@hosts.1/@nodes.3">
    <chaincodes/>
  </channels>
  <channels orderedBy="//@organizations.1/@hosts.1/@nodes.3"/>
  <channels orderedBy="//@organizations.1/@hosts.0/@nodes.0">
    <chaincodes endorsedBy="//@organizations.1/@hosts.1/@nodes.0"/>
    <chaincodes endorsedBy="//@organizations.1/@hosts.1/@nodes.1 //@organizations.1/@hosts.1/@nodes.0"/>
    <chaincodes endorsedBy="//@organizations.1/@hosts.1/@nodes.0 //@organizations.1/@hosts.1/@nodes.1"/>
  </channels>
</dlt:KafkaFabricNetwork>
