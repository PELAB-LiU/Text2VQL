<?xml version="1.0" encoding="ASCII"?>
<dlt:KafkaFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.0"/>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.2 //@channels.3"/>
    </hosts>
    <hosts/>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.3/@chaincodes.2 //@channels.3/@chaincodes.1"/>
    </hosts>
  </organizations>
  <organizations>
    <hosts/>
  </organizations>
  <channels orderedBy="//@organizations.0/@hosts.0/@nodes.0">
    <chaincodes/>
    <chaincodes/>
  </channels>
  <channels/>
  <channels orderedBy="//@organizations.0/@hosts.0/@nodes.1">
    <chaincodes/>
  </channels>
  <channels orderedBy="//@organizations.0/@hosts.0/@nodes.1">
    <chaincodes/>
    <chaincodes endorsedBy="//@organizations.0/@hosts.2/@nodes.0"/>
    <chaincodes endorsedBy="//@organizations.0/@hosts.2/@nodes.0"/>
  </channels>
</dlt:KafkaFabricNetwork>
