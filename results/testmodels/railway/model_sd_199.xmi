<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes requires="//@regions.0/@sensors.1 //@regions.2/@sensors.1" entry="//@regions.0/@elements.1/@semaphores.1" exit="//@regions.0/@elements.1/@semaphores.0">
    <follows target="//@regions.0/@elements.3"/>
    <follows target="//@regions.2/@elements.3"/>
  </routes>
  <routes active="true" entry="//@regions.0/@elements.1/@semaphores.0" exit="//@regions.0/@elements.1/@semaphores.1">
    <follows position="DIVERGING" target="//@regions.0/@elements.2"/>
  </routes>
  <regions>
    <sensors monitors="//@regions.0/@elements.2 //@regions.2/@elements.3 //@regions.1/@elements.1 //@regions.2/@elements.1"/>
    <sensors monitors="//@regions.2/@elements.2"/>
    <elements xsi:type="Segment" connectsTo="//@regions.2/@elements.1"/>
    <elements xsi:type="Segment" connectsTo="//@regions.2/@elements.3 //@regions.1/@elements.1">
      <semaphores signal="STOP"/>
      <semaphores/>
    </elements>
    <elements xsi:type="Switch" monitoredBy="//@regions.2/@sensors.2 //@regions.1/@sensors.1 //@regions.0/@sensors.0" connectsTo="//@regions.2/@elements.3 //@regions.0/@elements.3 //@regions.0/@elements.1" positions="//@routes.1/@follows.0"/>
    <elements xsi:type="Switch" currentPosition="STRAIGHT" positions="//@routes.0/@follows.0"/>
  </regions>
  <regions>
    <sensors/>
    <sensors monitors="//@regions.2/@elements.3 //@regions.0/@elements.2"/>
    <sensors/>
    <elements xsi:type="Segment" monitoredBy="//@regions.2/@sensors.3"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.0 //@regions.2/@sensors.0" connectsTo="//@regions.0/@elements.3" length="-1"/>
  </regions>
  <regions>
    <sensors monitors="//@regions.1/@elements.1"/>
    <sensors monitors="//@regions.2/@elements.3 //@regions.2/@elements.4 //@regions.2/@elements.0"/>
    <sensors monitors="//@regions.0/@elements.2"/>
    <sensors monitors="//@regions.2/@elements.0 //@regions.1/@elements.0"/>
    <elements xsi:type="Switch" monitoredBy="//@regions.2/@sensors.1 //@regions.2/@sensors.3" connectsTo="//@regions.0/@elements.2 //@regions.2/@elements.2 //@regions.1/@elements.1" currentPosition="STRAIGHT"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.0" connectsTo="//@regions.0/@elements.3"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.1" connectsTo="//@regions.0/@elements.1 //@regions.2/@elements.4">
      <semaphores/>
    </elements>
    <elements xsi:type="Switch" monitoredBy="//@regions.1/@sensors.1 //@regions.0/@sensors.0 //@regions.2/@sensors.1" connectsTo="//@regions.2/@elements.2 //@regions.0/@elements.0" positions="//@routes.0/@follows.1"/>
    <elements xsi:type="Switch" monitoredBy="//@regions.2/@sensors.1" connectsTo="//@regions.2/@elements.2"/>
    <elements xsi:type="Segment" connectsTo="//@regions.0/@elements.2"/>
  </regions>
</RailwayContainer>
