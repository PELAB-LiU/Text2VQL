<?xml version="1.0" encoding="ASCII"?>
<dlt:RaftFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations/>
  <organizations/>
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.0 //@channels.2"/>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.3"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.1/@chaincodes.0"/>
    </hosts>
  </organizations>
  <channels orderedBy="//@organizations.2/@hosts.0/@nodes.0">
    <chaincodes/>
  </channels>
  <channels>
    <chaincodes endorsedBy="//@organizations.2/@hosts.0/@nodes.2"/>
    <chaincodes/>
  </channels>
  <channels orderedBy="//@organizations.2/@hosts.0/@nodes.0">
    <chaincodes/>
    <chaincodes/>
    <chaincodes/>
    <chaincodes/>
  </channels>
  <channels orderedBy="//@organizations.2/@hosts.0/@nodes.1">
    <chaincodes/>
  </channels>
</dlt:RaftFabricNetwork>
