<?xml version="1.0" encoding="ASCII"?>
<dlt:RaftFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.0"/>
      <nodes xsi:type="dlt:EndorsingNode"/>
    </hosts>
    <hosts/>
  </organizations>
  <organizations>
    <hosts/>
    <hosts/>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.2/@chaincodes.0"/>
    </hosts>
  </organizations>
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.2"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.2/@chaincodes.0"/>
    </hosts>
    <hosts/>
  </organizations>
  <channels orderedBy="//@organizations.0/@hosts.0/@nodes.0"/>
  <channels/>
  <channels orderedBy="//@organizations.2/@hosts.0/@nodes.0">
    <chaincodes endorsedBy="//@organizations.1/@hosts.2/@nodes.0 //@organizations.2/@hosts.0/@nodes.1"/>
  </channels>
</dlt:RaftFabricNetwork>
