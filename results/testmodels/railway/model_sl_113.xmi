<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes active="true" requires="//@regions.0/@sensors.2" entry="//@regions.0/@elements.2/@semaphores.0" exit="//@regions.0/@elements.2/@semaphores.0">
    <follows position="DIVERGING" target="//@regions.0/@elements.1"/>
  </routes>
  <regions>
    <sensors/>
    <sensors monitors="//@regions.0/@elements.1 //@regions.0/@elements.2"/>
    <sensors monitors="//@regions.0/@elements.2 //@regions.0/@elements.1 //@regions.0/@elements.4"/>
    <elements xsi:type="Segment" connectsTo="//@regions.0/@elements.1"/>
    <elements xsi:type="Switch" monitoredBy="//@regions.0/@sensors.1 //@regions.0/@sensors.2" currentPosition="STRAIGHT" positions="//@routes.0/@follows.0"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.1 //@regions.0/@sensors.2" connectsTo="//@regions.0/@elements.1" length="-2">
      <semaphores signal="GO"/>
    </elements>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.1"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.2" length="2"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.1" connectsTo="//@regions.0/@elements.3 //@regions.0/@elements.1" length="-6"/>
  </regions>
  <regions>
    <sensors/>
    <sensors monitors="//@regions.0/@elements.5 //@regions.0/@elements.3"/>
  </regions>
</RailwayContainer>
