<?xml version="1.0" encoding="ASCII"?>
<dlt:KafkaFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode"/>
    </hosts>
    <hosts/>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.0"/>
    </hosts>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.0/@chaincodes.1 //@channels.2/@chaincodes.1"/>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.2"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.2/@chaincodes.2 //@channels.2/@chaincodes.1 //@channels.0/@chaincodes.1 //@channels.0/@chaincodes.0 //@channels.2/@chaincodes.0 //@channels.0/@chaincodes.2 //@channels.0/@chaincodes.4"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.0/@chaincodes.3 //@channels.2/@chaincodes.0 //@channels.0/@chaincodes.2 //@channels.2/@chaincodes.2"/>
    </hosts>
  </organizations>
  <organizations/>
  <organizations/>
  <channels orderedBy="//@organizations.0/@hosts.2/@nodes.0">
    <chaincodes endorsedBy="//@organizations.0/@hosts.3/@nodes.2"/>
    <chaincodes endorsedBy="//@organizations.0/@hosts.3/@nodes.2 //@organizations.0/@hosts.3/@nodes.0"/>
    <chaincodes endorsedBy="//@organizations.0/@hosts.3/@nodes.2 //@organizations.0/@hosts.3/@nodes.3"/>
    <chaincodes endorsedBy="//@organizations.0/@hosts.3/@nodes.3"/>
    <chaincodes endorsedBy="//@organizations.0/@hosts.3/@nodes.2"/>
  </channels>
  <channels/>
  <channels orderedBy="//@organizations.0/@hosts.3/@nodes.1">
    <chaincodes endorsedBy="//@organizations.0/@hosts.3/@nodes.2 //@organizations.0/@hosts.3/@nodes.3"/>
    <chaincodes endorsedBy="//@organizations.0/@hosts.3/@nodes.2 //@organizations.0/@hosts.3/@nodes.0"/>
    <chaincodes endorsedBy="//@organizations.0/@hosts.3/@nodes.2 //@organizations.0/@hosts.3/@nodes.3"/>
  </channels>
</dlt:KafkaFabricNetwork>
