    </elements>
    <elements xsi:type="Segment" connectsTo="//@regions.1/@elements.2" length="57"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.3" length="2"/>
    <elements xsi:type="Segment" length="47"/>
  </regions>
</RailwayContainer>
