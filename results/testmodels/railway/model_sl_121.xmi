    <elements xsi:type="Switch" monitoredBy="//@regions.1/@sensors.4 //@regions.1/@sensors.1" connectsTo="//@regions.1/@elements.3 //@regions.1/@elements.4 //@regions.1/@elements.0" currentPosition="STRAIGHT"/>
    <elements xsi:type="Switch" connectsTo="//@regions.1/@elements.0 //@regions.1/@elements.3 //@regions.1/@elements.1" currentPosition="DIVERGING" positions="//@routes.0/@follows.0"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.4 //@regions.1/@sensors.1 //@regions.1/@sensors.0" connectsTo="//@regions.1/@elements.2 //@regions.1/@elements.0" length="-2">
