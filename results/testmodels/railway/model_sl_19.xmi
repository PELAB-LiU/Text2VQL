<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes requires="//@regions.0/@sensors.0" entry="//@regions.0/@elements.0/@semaphores.0" exit="//@regions.0/@elements.0/@semaphores.0">
    <follows position="STRAIGHT" target="//@regions.0/@elements.3"/>
  </routes>
  <regions>
    <sensors monitors="//@regions.0/@elements.1 //@regions.0/@elements.4 //@regions.0/@elements.0"/>
    <sensors/>
    <sensors/>
    <sensors/>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.0" connectsTo="//@regions.0/@elements.1" length="3">
      <semaphores/>
    </elements>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.0" connectsTo="//@regions.1/@elements.0 //@regions.0/@elements.2" length="3"/>
    <elements xsi:type="Segment" connectsTo="//@regions.0/@elements.4"/>
    <elements xsi:type="Switch" connectsTo="//@regions.0/@elements.2" currentPosition="DIVERGING" positions="//@routes.0/@follows.0"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.0" length="64"/>
  </regions>
  <regions>
    <sensors/>
    <elements xsi:type="Segment" connectsTo="//@regions.0/@elements.1" length="40"/>
  </regions>
</RailwayContainer>
