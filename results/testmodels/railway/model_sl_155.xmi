<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes entry="//@regions.0/@elements.1/@semaphores.0" exit="//@regions.0/@elements.1/@semaphores.0">
    <follows position="STRAIGHT" target="//@regions.1/@elements.1"/>
  </routes>
  <regions>
    <sensors monitors="//@regions.0/@elements.2"/>
    <sensors monitors="//@regions.0/@elements.2 //@regions.0/@elements.1"/>
    <sensors/>
    <elements xsi:type="Segment" connectsTo="//@regions.0/@elements.2 //@regions.0/@elements.1" length="30"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.1" connectsTo="//@regions.0/@elements.0" length="-4">
      <semaphores/>
    </elements>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.1 //@regions.0/@sensors.0" connectsTo="//@regions.1/@elements.0" length="69"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.1" connectsTo="//@regions.0/@elements.2" length="2"/>
  </regions>
  <regions>
    <sensors/>
    <sensors monitors="//@regions.0/@elements.3"/>
    <elements xsi:type="Segment" connectsTo="//@regions.0/@elements.0 //@regions.0/@elements.2" length="-6"/>
    <elements xsi:type="Switch" currentPosition="DIVERGING" positions="//@routes.0/@follows.0"/>
  </regions>
</RailwayContainer>
