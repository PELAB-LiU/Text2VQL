    <elements xsi:type="Switch" monitoredBy="//@regions.1/@sensors.2 //@regions.1/@sensors.0" connectsTo="//@regions.1/@elements.4 //@regions.1/@elements.0 //@regions.1/@elements.2" currentPosition="STRAIGHT" positions="//@routes.0/@follows.0"/>
