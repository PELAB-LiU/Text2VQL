<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes active="true" requires="//@regions.0/@sensors.2 //@regions.1/@sensors.0" entry="//@regions.0/@elements.2/@semaphores.0" exit="//@regions.0/@elements.2/@semaphores.0">
    <follows position="STRAIGHT" target="//@regions.1/@elements.6"/>
    <follows target="//@regions.0/@elements.4"/>
  </routes>
  <routes entry="//@regions.0/@elements.2/@semaphores.0" exit="//@regions.0/@elements.2/@semaphores.0">
    <follows position="STRAIGHT" target="//@regions.0/@elements.3"/>
  </routes>
  <regions>
    <sensors monitors="//@regions.0/@elements.0"/>
    <sensors/>
    <sensors monitors="//@regions.0/@elements.0"/>
    <sensors monitors="//@regions.0/@elements.2 //@regions.1/@elements.6"/>
    <sensors monitors="//@regions.1/@elements.4 //@regions.1/@elements.2 //@regions.0/@elements.2"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.0 //@regions.0/@sensors.2 //@regions.0/@sensors.0" connectsTo="//@regions.1/@elements.1"/>
    <elements xsi:type="Segment" connectsTo="//@regions.0/@elements.0" length="45"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.3 //@regions.0/@sensors.4" connectsTo="//@regions.1/@elements.2 //@regions.1/@elements.4" length="-6">
      <semaphores signal="GO"/>
    </elements>
    <elements xsi:type="Switch" monitoredBy="//@regions.1/@sensors.1 //@regions.1/@sensors.0" connectsTo="//@regions.1/@elements.6 //@regions.0/@elements.4" currentPosition="DIVERGING" positions="//@routes.1/@follows.0"/>
    <elements xsi:type="Switch" connectsTo="//@regions.1/@elements.4 //@regions.1/@elements.2" currentPosition="STRAIGHT" positions="//@routes.0/@follows.1"/>
  </regions>
  <regions>
    <sensors monitors="//@regions.0/@elements.0 //@regions.1/@elements.0 //@regions.1/@elements.4 //@regions.1/@elements.2 //@regions.0/@elements.3"/>
    <sensors monitors="//@regions.0/@elements.3 //@regions.1/@elements.4 //@regions.1/@elements.2"/>
    <sensors monitors="//@regions.1/@elements.4"/>
    <sensors/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.0" connectsTo="//@regions.0/@elements.1" length="-2"/>
    <elements xsi:type="Switch" connectsTo="//@regions.0/@elements.4 //@regions.0/@elements.0"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.0 //@regions.0/@sensors.4 //@regions.1/@sensors.1" connectsTo="//@regions.1/@elements.1 //@regions.0/@elements.4" length="-5"/>
    <elements xsi:type="Segment" connectsTo="//@regions.1/@elements.0" length="66"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.2 //@regions.1/@sensors.0 //@regions.0/@sensors.4 //@regions.1/@sensors.1">
      <semaphores signal="STOP"/>
    </elements>
    <elements xsi:type="Segment" connectsTo="//@regions.0/@elements.3 //@regions.1/@elements.6" length="87">
      <semaphores/>
    </elements>
    <elements xsi:type="Switch" monitoredBy="//@regions.0/@sensors.3" connectsTo="//@regions.1/@elements.5 //@regions.0/@elements.3 //@regions.0/@elements.4" positions="//@routes.0/@follows.0"/>
  </regions>
</RailwayContainer>
