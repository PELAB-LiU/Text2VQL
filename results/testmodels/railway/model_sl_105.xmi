<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes requires="//@regions.0/@sensors.0 //@regions.1/@sensors.1" entry="//@regions.0/@elements.1/@semaphores.0" exit="//@regions.0/@elements.1/@semaphores.0">
    <follows position="DIVERGING" target="//@regions.1/@elements.2"/>
  </routes>
  <regions>
    <sensors/>
    <sensors/>
    <sensors/>
    <elements xsi:type="Segment"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.0" connectsTo="//@regions.1/@elements.2" length="14">
      <semaphores signal="GO"/>
    </elements>
  </regions>
  <regions>
    <sensors monitors="//@regions.0/@elements.1"/>
    <sensors/>
    <elements xsi:type="Segment"/>
    <elements xsi:type="Segment"/>
    <elements xsi:type="Switch" positions="//@routes.0/@follows.0"/>
  </regions>
  <regions>
    <sensors/>
    <sensors/>
  </regions>
  <regions>
    <elements xsi:type="Segment" connectsTo="//@regions.1/@elements.2" length="13"/>
  </regions>
</RailwayContainer>
