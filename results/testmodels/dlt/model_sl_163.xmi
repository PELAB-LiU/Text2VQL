<?xml version="1.0" encoding="ASCII"?>
<dlt:RaftFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.2/@chaincodes.0 //@channels.0/@chaincodes.1 //@channels.1/@chaincodes.0"/>
      <nodes xsi:type="dlt:OrderingNode"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.1/@chaincodes.0"/>
    </hosts>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.0 //@channels.1 //@channels.2"/>
      <nodes xsi:type="dlt:OrderingNode"/>
    </hosts>
    <hosts/>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode"/>
    </hosts>
  </organizations>
  <channels orderedBy="//@organizations.0/@hosts.1/@nodes.0">
    <chaincodes/>
    <chaincodes endorsedBy="//@organizations.0/@hosts.0/@nodes.0"/>
    <chaincodes/>
  </channels>
  <channels orderedBy="//@organizations.0/@hosts.1/@nodes.0">
    <chaincodes endorsedBy="//@organizations.0/@hosts.0/@nodes.0 //@organizations.0/@hosts.0/@nodes.2"/>
  </channels>
  <channels orderedBy="//@organizations.0/@hosts.1/@nodes.0">
    <chaincodes endorsedBy="//@organizations.0/@hosts.0/@nodes.0"/>
  </channels>
</dlt:RaftFabricNetwork>
