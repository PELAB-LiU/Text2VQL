<?xml version="1.0" encoding="ASCII"?>
<dlt:KafkaFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations>
    <hosts/>
  </organizations>
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode"/>
    </hosts>
    <hosts/>
  </organizations>
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode"/>
    </hosts>
    <hosts/>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.0 //@channels.2"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.2/@chaincodes.1"/>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.1"/>
    </hosts>
  </organizations>
  <channels orderedBy="//@organizations.2/@hosts.2/@nodes.0"/>
  <channels orderedBy="//@organizations.2/@hosts.2/@nodes.2"/>
  <channels orderedBy="//@organizations.2/@hosts.2/@nodes.0">
    <chaincodes/>
    <chaincodes endorsedBy="//@organizations.2/@hosts.2/@nodes.1"/>
  </channels>
</dlt:KafkaFabricNetwork>
