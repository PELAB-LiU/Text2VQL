<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes active="true" requires="//@regions.0/@sensors.0 //@regions.0/@sensors.1 //@regions.1/@sensors.0 //@regions.0/@sensors.2" entry="//@regions.0/@elements.1/@semaphores.0" exit="//@regions.0/@elements.1/@semaphores.0">
