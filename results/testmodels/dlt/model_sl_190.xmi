<?xml version="1.0" encoding="ASCII"?>
<dlt:RaftFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode"/>
    </hosts>
  </organizations>
  <organizations>
    <hosts/>
  </organizations>
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode"/>
    </hosts>
    <hosts/>
  </organizations>
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.1"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.1/@chaincodes.0 //@channels.1/@chaincodes.1"/>
    </hosts>
  </organizations>
  <channels/>
  <channels orderedBy="//@organizations.3/@hosts.0/@nodes.0">
    <chaincodes endorsedBy="//@organizations.3/@hosts.0/@nodes.1"/>
    <chaincodes endorsedBy="//@organizations.3/@hosts.0/@nodes.1"/>
    <chaincodes/>
  </channels>
  <channels/>
</dlt:RaftFabricNetwork>
