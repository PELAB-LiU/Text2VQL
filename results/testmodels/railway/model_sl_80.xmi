<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes active="true" requires="//@regions.0/@sensors.4" entry="//@regions.0/@elements.4/@semaphores.0" exit="//@regions.0/@elements.4/@semaphores.0"/>
  <routes requires="//@regions.0/@sensors.3" entry="//@regions.0/@elements.4/@semaphores.0" exit="//@regions.0/@elements.4/@semaphores.0">
    <follows position="DIVERGING" target="//@regions.0/@elements.1"/>
  </routes>
  <regions>
    <sensors/>
    <sensors/>
    <sensors monitors="//@regions.0/@elements.2 //@regions.0/@elements.0"/>
    <sensors/>
    <sensors monitors="//@regions.0/@elements.4 //@regions.0/@elements.3"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.2" connectsTo="//@regions.0/@elements.5 //@regions.0/@elements.2" length="-7"/>
    <elements xsi:type="Switch" currentPosition="DIVERGING" positions="//@routes.1/@follows.0"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.2" connectsTo="//@regions.0/@elements.4 //@regions.0/@elements.3"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.4" connectsTo="//@regions.0/@elements.4" length="-3"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.4" length="-8">
      <semaphores/>
    </elements>
    <elements xsi:type="Segment" connectsTo="//@regions.0/@elements.3 //@regions.0/@elements.4" length="60"/>
  </regions>
</RailwayContainer>
