    <elements xsi:type="Segment" monitoredBy="//@regions.3/@sensors.3 //@regions.3/@sensors.1 //@regions.1/@sensors.1" connectsTo="//@regions.3/@elements.1 //@regions.1/@elements.2" length="-5"/>
    <elements xsi:type="Switch" connectsTo="//@regions.3/@elements.1 //@regions.3/@elements.2 //@regions.1/@elements.0"/>
  </regions>
  <regions>
