<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes requires="//@regions.1/@sensors.0 //@regions.1/@sensors.3" entry="//@regions.2/@elements.1/@semaphores.0" exit="//@regions.2/@elements.1/@semaphores.0">
    <follows position="STRAIGHT" target="//@regions.2/@elements.2"/>
  </routes>
  <regions>
    <elements xsi:type="Segment" length="-1"/>
  </regions>
  <regions>
    <sensors monitors="//@regions.2/@elements.3 //@regions.1/@elements.0"/>
    <sensors monitors="//@regions.1/@elements.0"/>
    <sensors monitors="//@regions.2/@elements.1 //@regions.2/@elements.0"/>
    <sensors monitors="//@regions.2/@elements.2 //@regions.2/@elements.3"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.1 //@regions.2/@sensors.0 //@regions.1/@sensors.0" connectsTo="//@regions.2/@elements.0 //@regions.2/@elements.2" length="15"/>
  </regions>
  <regions>
    <sensors monitors="//@regions.2/@elements.1 //@regions.1/@elements.0"/>
    <sensors monitors="//@regions.2/@elements.3 //@regions.2/@elements.1 //@regions.2/@elements.0"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.2 //@regions.2/@sensors.1" connectsTo="//@regions.2/@elements.2" length="40"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.2 //@regions.2/@sensors.0 //@regions.2/@sensors.1" connectsTo="//@regions.1/@elements.0 //@regions.2/@elements.2">
      <semaphores signal="STOP"/>
    </elements>
    <elements xsi:type="Switch" monitoredBy="//@regions.1/@sensors.3" connectsTo="//@regions.2/@elements.0 //@regions.2/@elements.1" positions="//@routes.0/@follows.0"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.2/@sensors.1 //@regions.1/@sensors.0 //@regions.1/@sensors.3" connectsTo="//@regions.2/@elements.2" length="-4"/>
  </regions>
</RailwayContainer>
