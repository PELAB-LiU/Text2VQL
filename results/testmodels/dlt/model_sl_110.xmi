<?xml version="1.0" encoding="ASCII"?>
<dlt:KafkaFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations>
    <hosts/>
  </organizations>
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.0"/>
      <nodes xsi:type="dlt:OrderingNode"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.2/@chaincodes.4 //@channels.2/@chaincodes.3"/>
      <nodes xsi:type="dlt:OrderingNode"/>
    </hosts>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.1 //@channels.2"/>
    </hosts>
  </organizations>
  <organizations/>
  <channels orderedBy="//@organizations.1/@hosts.0/@nodes.0"/>
  <channels orderedBy="//@organizations.1/@hosts.1/@nodes.0"/>
  <channels orderedBy="//@organizations.1/@hosts.1/@nodes.0">
    <chaincodes/>
    <chaincodes/>
    <chaincodes/>
    <chaincodes endorsedBy="//@organizations.1/@hosts.0/@nodes.2"/>
    <chaincodes endorsedBy="//@organizations.1/@hosts.0/@nodes.2"/>
  </channels>
</dlt:KafkaFabricNetwork>
