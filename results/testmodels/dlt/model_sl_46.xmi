<?xml version="1.0" encoding="ASCII"?>
<dlt:KafkaFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode"/>
    </hosts>
  </organizations>
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode"/>
    </hosts>
  </organizations>
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.0/@chaincodes.0"/>
    </hosts>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.0/@chaincodes.3 //@channels.0/@chaincodes.1 //@channels.0/@chaincodes.2 //@channels.0/@chaincodes.0"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.0/@chaincodes.3 //@channels.0/@chaincodes.0"/>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.0"/>
    </hosts>
  </organizations>
  <channels orderedBy="//@organizations.2/@hosts.1/@nodes.3">
    <chaincodes endorsedBy="//@organizations.2/@hosts.1/@nodes.1 //@organizations.2/@hosts.0/@nodes.0 //@organizations.2/@hosts.1/@nodes.2"/>
    <chaincodes endorsedBy="//@organizations.2/@hosts.1/@nodes.1"/>
    <chaincodes endorsedBy="//@organizations.2/@hosts.1/@nodes.1"/>
    <chaincodes endorsedBy="//@organizations.2/@hosts.1/@nodes.1 //@organizations.2/@hosts.1/@nodes.2"/>
  </channels>
</dlt:KafkaFabricNetwork>
