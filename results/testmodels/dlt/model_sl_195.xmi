<?xml version="1.0" encoding="ASCII"?>
<dlt:KafkaFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations/>
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.1"/>
      <nodes xsi:type="dlt:OrderingNode"/>
    </hosts>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.2/@chaincodes.1"/>
    </hosts>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode"/>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.2"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.2/@chaincodes.1"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.2/@chaincodes.1"/>
    </hosts>
  </organizations>
  <channels>
    <chaincodes/>
  </channels>
  <channels orderedBy="//@organizations.1/@hosts.0/@nodes.0">
    <chaincodes/>
  </channels>
  <channels orderedBy="//@organizations.1/@hosts.2/@nodes.1">
    <chaincodes/>
    <chaincodes endorsedBy="//@organizations.1/@hosts.2/@nodes.3 //@organizations.1/@hosts.1/@nodes.0 //@organizations.1/@hosts.2/@nodes.2"/>
  </channels>
</dlt:KafkaFabricNetwork>
