<?xml version="1.0" encoding="ASCII"?>
<dlt:KafkaFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations/>
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode"/>
    </hosts>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.2/@chaincodes.1"/>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.4 //@channels.1"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.0/@chaincodes.0 //@channels.4/@chaincodes.1"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.2/@chaincodes.0"/>
    </hosts>
  </organizations>
  <channels>
    <chaincodes endorsedBy="//@organizations.1/@hosts.1/@nodes.2"/>
  </channels>
  <channels orderedBy="//@organizations.1/@hosts.1/@nodes.1"/>
  <channels>
    <chaincodes endorsedBy="//@organizations.1/@hosts.1/@nodes.3"/>
    <chaincodes endorsedBy="//@organizations.1/@hosts.1/@nodes.0"/>
  </channels>
  <channels/>
  <channels orderedBy="//@organizations.1/@hosts.1/@nodes.1">
    <chaincodes/>
    <chaincodes endorsedBy="//@organizations.1/@hosts.1/@nodes.2"/>
  </channels>
</dlt:KafkaFabricNetwork>
