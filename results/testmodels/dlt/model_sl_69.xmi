<?xml version="1.0" encoding="ASCII"?>
<dlt:RaftFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations/>
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode"/>
      <nodes xsi:type="dlt:EndorsingNode"/>
      <nodes xsi:type="dlt:EndorsingNode"/>
    </hosts>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode"/>
      <nodes xsi:type="dlt:OrderingNode"/>
    </hosts>
    <hosts/>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.2"/>
      <nodes xsi:type="dlt:EndorsingNode"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.0/@chaincodes.0"/>
      <nodes xsi:type="dlt:EndorsingNode"/>
    </hosts>
  </organizations>
  <channels>
    <chaincodes endorsedBy="//@organizations.1/@hosts.3/@nodes.2"/>
  </channels>
  <channels/>
  <channels orderedBy="//@organizations.1/@hosts.3/@nodes.0"/>
</dlt:RaftFabricNetwork>
