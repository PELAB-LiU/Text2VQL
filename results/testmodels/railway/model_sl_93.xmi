<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes requires="//@regions.1/@sensors.1 //@regions.1/@sensors.3" entry="//@regions.0/@elements.2/@semaphores.0" exit="//@regions.0/@elements.2/@semaphores.0">
    <follows position="STRAIGHT" target="//@regions.1/@elements.0"/>
  </routes>
  <regions>
    <sensors monitors="//@regions.0/@elements.2"/>
    <elements xsi:type="Segment"/>
    <elements xsi:type="Segment" connectsTo="//@regions.0/@elements.0 //@regions.1/@elements.2"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.3 //@regions.0/@sensors.0" connectsTo="//@regions.1/@elements.2 //@regions.0/@elements.1">
      <semaphores signal="STOP"/>
    </elements>
  </regions>
  <regions>
    <sensors/>
    <sensors monitors="//@regions.1/@elements.0 //@regions.1/@elements.2"/>
    <sensors monitors="//@regions.1/@elements.2"/>
    <sensors monitors="//@regions.0/@elements.2 //@regions.1/@elements.0"/>
    <elements xsi:type="Switch" monitoredBy="//@regions.1/@sensors.1 //@regions.1/@sensors.3" connectsTo="//@regions.0/@elements.2" currentPosition="STRAIGHT" positions="//@routes.0/@follows.0"/>
    <elements xsi:type="Segment" length="17"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.2 //@regions.1/@sensors.1" connectsTo="//@regions.0/@elements.1" length="25"/>
  </regions>
</RailwayContainer>
