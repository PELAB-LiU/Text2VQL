<?xml version="1.0" encoding="ASCII"?>
<dlt:KafkaFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations/>
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.0"/>
    </hosts>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode"/>
    </hosts>
  </organizations>
  <organizations>
    <hosts/>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode"/>
    </hosts>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.2"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.2/@chaincodes.0"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.2/@chaincodes.0"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.2/@chaincodes.0"/>
    </hosts>
  </organizations>
  <channels orderedBy="//@organizations.1/@hosts.0/@nodes.0"/>
  <channels/>
  <channels orderedBy="//@organizations.2/@hosts.2/@nodes.0">
    <chaincodes endorsedBy="//@organizations.2/@hosts.2/@nodes.1 //@organizations.2/@hosts.2/@nodes.2 //@organizations.2/@hosts.2/@nodes.3"/>
  </channels>
</dlt:KafkaFabricNetwork>
