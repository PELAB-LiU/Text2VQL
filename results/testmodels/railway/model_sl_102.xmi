<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes requires="//@regions.2/@sensors.0 //@regions.3/@sensors.0" entry="//@regions.1/@elements.0/@semaphores.0" exit="//@regions.1/@elements.0/@semaphores.0">
    <follows position="DIVERGING" target="//@regions.1/@elements.1"/>
  </routes>
  <regions>
    <sensors/>
    <sensors monitors="//@regions.1/@elements.2"/>
    <sensors monitors="//@regions.1/@elements.0 //@regions.1/@elements.1"/>
    <elements xsi:type="Segment"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.2/@sensors.0" connectsTo="//@regions.1/@elements.0" length="-1"/>
  </regions>
  <regions>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.2 //@regions.3/@sensors.1 //@regions.3/@sensors.3 //@regions.3/@sensors.0 //@regions.2/@sensors.0 //@regions.3/@sensors.2" connectsTo="//@regions.0/@elements.1 //@regions.1/@elements.1" length="-6">
      <semaphores signal="STOP"/>
    </elements>
    <elements xsi:type="Switch" monitoredBy="//@regions.0/@sensors.2 //@regions.2/@sensors.0 //@regions.3/@sensors.3 //@regions.3/@sensors.0 //@regions.3/@sensors.1 //@regions.3/@sensors.2" connectsTo="//@regions.1/@elements.0" currentPosition="STRAIGHT" positions="//@routes.0/@follows.0"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.1" length="-6"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.2/@sensors.0 //@regions.3/@sensors.0 //@regions.3/@sensors.3 //@regions.3/@sensors.1" connectsTo="//@regions.1/@elements.2 //@regions.0/@elements.1"/>
  </regions>
  <regions>
    <sensors monitors="//@regions.1/@elements.1 //@regions.0/@elements.1 //@regions.1/@elements.3 //@regions.1/@elements.0"/>
  </regions>
  <regions>
    <sensors monitors="//@regions.1/@elements.1 //@regions.1/@elements.0 //@regions.1/@elements.3"/>
    <sensors monitors="//@regions.1/@elements.0 //@regions.1/@elements.1 //@regions.1/@elements.3"/>
    <sensors monitors="//@regions.1/@elements.1 //@regions.1/@elements.0"/>
    <sensors monitors="//@regions.1/@elements.1 //@regions.1/@elements.0 //@regions.1/@elements.3"/>
  </regions>
</RailwayContainer>
