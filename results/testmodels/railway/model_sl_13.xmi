<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes requires="//@regions.1/@sensors.0" entry="//@regions.1/@elements.2/@semaphores.0" exit="//@regions.1/@elements.2/@semaphores.0">
    <follows position="STRAIGHT" target="//@regions.1/@elements.1"/>
  </routes>
  <regions>
    <sensors/>
    <elements xsi:type="Segment" connectsTo="//@regions.1/@elements.1" length="45"/>
