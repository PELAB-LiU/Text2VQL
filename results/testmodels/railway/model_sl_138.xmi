<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes active="true" requires="//@regions.0/@sensors.1 //@regions.0/@sensors.0 //@regions.0/@sensors.3" entry="//@regions.0/@elements.1/@semaphores.0" exit="//@regions.0/@elements.1/@semaphores.0">
    <follows position="STRAIGHT" target="//@regions.0/@elements.0"/>
  </routes>
  <regions>
    <sensors monitors="//@regions.0/@elements.0"/>
    <sensors/>
    <sensors/>
    <sensors monitors="//@regions.3/@elements.0 //@regions.0/@elements.0"/>
    <elements xsi:type="Switch" monitoredBy="//@regions.0/@sensors.0 //@regions.3/@sensors.1 //@regions.0/@sensors.3" connectsTo="//@regions.0/@elements.3" currentPosition="DIVERGING" positions="//@routes.0/@follows.0"/>
    <elements xsi:type="Segment" connectsTo="//@regions.2/@elements.0 //@regions.3/@elements.0" length="-10">
      <semaphores signal="GO"/>
    </elements>
    <elements xsi:type="Segment" connectsTo="//@regions.0/@elements.0" length="-5"/>
    <elements xsi:type="Segment"/>
  </regions>
  <regions/>
  <regions>
    <elements xsi:type="Segment" connectsTo="//@regions.3/@elements.0" length="-4"/>
  </regions>
  <regions>
    <sensors/>
    <sensors monitors="//@regions.0/@elements.0"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.3" connectsTo="//@regions.2/@elements.0"/>
  </regions>
</RailwayContainer>
