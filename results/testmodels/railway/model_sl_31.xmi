<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes requires="//@regions.2/@sensors.0 //@regions.2/@sensors.1 //@regions.0/@sensors.3 //@regions.2/@sensors.2" entry="//@regions.1/@elements.3/@semaphores.0" exit="//@regions.1/@elements.3/@semaphores.0">
    <follows position="STRAIGHT" target="//@regions.1/@elements.2"/>
  </routes>
  <regions>
    <sensors/>
    <sensors/>
    <sensors monitors="//@regions.1/@elements.0 //@regions.1/@elements.3"/>
    <sensors monitors="//@regions.1/@elements.3 //@regions.3/@elements.0"/>
  </regions>
  <regions>
    <sensors monitors="//@regions.1/@elements.2 //@regions.3/@elements.0"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.2/@sensors.3 //@regions.2/@sensors.2 //@regions.0/@sensors.2" length="-10"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.2/@sensors.3 //@regions.3/@sensors.0" connectsTo="//@regions.3/@elements.0 //@regions.1/@elements.3"/>
    <elements xsi:type="Switch" monitoredBy="//@regions.1/@sensors.0" connectsTo="//@regions.3/@elements.0 //@regions.1/@elements.3" currentPosition="DIVERGING" positions="//@routes.0/@follows.0"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.2 //@regions.0/@sensors.3" connectsTo="//@regions.3/@elements.0 //@regions.1/@elements.1">
      <semaphores/>
    </elements>
  </regions>
  <regions>
    <sensors/>
    <sensors/>
    <sensors monitors="//@regions.3/@elements.0 //@regions.2/@elements.0 //@regions.1/@elements.0"/>
    <sensors monitors="//@regions.1/@elements.1 //@regions.1/@elements.0"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.2/@sensors.2" connectsTo="//@regions.1/@elements.2 //@regions.3/@elements.0"/>
  </regions>
  <regions>
    <sensors monitors="//@regions.1/@elements.1"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.2/@sensors.2 //@regions.0/@sensors.3 //@regions.1/@sensors.0" connectsTo="//@regions.1/@elements.3" length="-4"/>
  </regions>
</RailwayContainer>
