    <elements xsi:type="Segment" monitoredBy="//@regions.3/@sensors.4 //@regions.3/@sensors.0 //@regions.3/@sensors.1" connectsTo="//@regions.0/@elements.4 //@regions.0/@elements.2" length="99"/>
