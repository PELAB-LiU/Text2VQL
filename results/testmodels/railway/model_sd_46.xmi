    <elements xsi:type="Segment" monitoredBy="//@regions.3/@sensors.4 //@regions.1/@sensors.1"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.1" connectsTo="//@regions.1/@elements.1 //@regions.1/@elements.0" length="-6"/>
    <elements xsi:type="Segment"/>
  </regions>
  <regions>
