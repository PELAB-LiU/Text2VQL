<?xml version="1.0" encoding="ASCII"?>
<dlt:KafkaFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode"/>
    </hosts>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode"/>
    </hosts>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.0/@chaincodes.0"/>
      <nodes xsi:type="dlt:EndorsingNode"/>
      <nodes xsi:type="dlt:OrderingNode"/>
    </hosts>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.0/@chaincodes.0"/>
      <nodes xsi:type="dlt:OrderingNode"/>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.0"/>
    </hosts>
  </organizations>
  <channels orderedBy="//@organizations.0/@hosts.3/@nodes.3">
    <chaincodes endorsedBy="//@organizations.0/@hosts.3/@nodes.1 //@organizations.0/@hosts.2/@nodes.1"/>
    <chaincodes/>
  </channels>
  <channels/>
</dlt:KafkaFabricNetwork>
