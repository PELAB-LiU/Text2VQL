<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes active="true" requires="//@regions.1/@sensors.1" entry="//@regions.1/@elements.1/@semaphores.0" exit="//@regions.1/@elements.1/@semaphores.0">
    <follows target="//@regions.2/@elements.1"/>
  </routes>
  <regions>
    <sensors monitors="//@regions.2/@elements.0 //@regions.2/@elements.1"/>
    <elements xsi:type="Segment"/>
  </regions>
  <regions>
    <sensors monitors="//@regions.1/@elements.1 //@regions.2/@elements.0"/>
    <sensors monitors="//@regions.2/@elements.1 //@regions.1/@elements.1 //@regions.2/@elements.0"/>
    <sensors/>
    <elements xsi:type="Segment"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.1 //@regions.1/@sensors.0">
      <semaphores/>
    </elements>
  </regions>
  <regions>
    <sensors/>
    <sensors/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.0 //@regions.1/@sensors.1 //@regions.0/@sensors.0" connectsTo="//@regions.1/@elements.1"/>
    <elements xsi:type="Switch" monitoredBy="//@regions.1/@sensors.1 //@regions.0/@sensors.0" positions="//@routes.0/@follows.0"/>
  </regions>
  <regions>
    <elements xsi:type="Segment" connectsTo="//@regions.1/@elements.1" length="-8"/>
  </regions>
</RailwayContainer>
