    <elements xsi:type="Switch" monitoredBy="//@regions.3/@sensors.4 //@regions.3/@sensors.1 //@regions.1/@sensors.1 //@regions.3/@sensors.5" connectsTo="//@regions.3/@elements.2 //@regions.3/@elements.0 //@regions.1/@elements.1" currentPosition="DIVERGING" positions="//@routes.1/@follows.0"/>
