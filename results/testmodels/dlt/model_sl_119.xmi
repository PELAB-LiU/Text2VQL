<?xml version="1.0" encoding="ASCII"?>
<dlt:KafkaFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.0"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.1/@chaincodes.0"/>
    </hosts>
  </organizations>
  <organizations>
    <hosts/>
  </organizations>
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.2 //@channels.1"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.1/@chaincodes.0"/>
    </hosts>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.1/@chaincodes.0"/>
    </hosts>
  </organizations>
  <channels orderedBy="//@organizations.0/@hosts.0/@nodes.0"/>
  <channels orderedBy="//@organizations.2/@hosts.0/@nodes.0">
    <chaincodes endorsedBy="//@organizations.0/@hosts.0/@nodes.1 //@organizations.2/@hosts.1/@nodes.1 //@organizations.2/@hosts.0/@nodes.1"/>
    <chaincodes/>
  </channels>
  <channels orderedBy="//@organizations.2/@hosts.0/@nodes.0">
    <chaincodes/>
  </channels>
</dlt:KafkaFabricNetwork>
