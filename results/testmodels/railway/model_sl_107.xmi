<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes active="true" requires="//@regions.0/@sensors.0" entry="//@regions.0/@elements.2/@semaphores.0" exit="//@regions.0/@elements.2/@semaphores.0">
    <follows position="DIVERGING" target="//@regions.0/@elements.3"/>
  </routes>
  <regions>
    <sensors monitors="//@regions.0/@elements.2"/>
    <sensors/>
    <elements xsi:type="Segment" connectsTo="//@regions.0/@elements.2 //@regions.1/@elements.0" length="-4"/>
    <elements xsi:type="Segment" connectsTo="//@regions.0/@elements.3" length="-3"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.0" connectsTo="//@regions.1/@elements.0 //@regions.0/@elements.1" length="59">
      <semaphores signal="GO"/>
    </elements>
    <elements xsi:type="Switch" connectsTo="//@regions.0/@elements.1" currentPosition="DIVERGING" positions="//@routes.0/@follows.0"/>
    <elements xsi:type="Segment" connectsTo="//@regions.0/@elements.1 //@regions.0/@elements.2"/>
  </regions>
  <regions>
    <sensors/>
    <sensors/>
    <sensors/>
    <elements xsi:type="Segment" connectsTo="//@regions.0/@elements.4 //@regions.0/@elements.0" length="-4"/>
  </regions>
</RailwayContainer>
