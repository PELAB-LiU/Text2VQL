    <elements xsi:type="Switch" monitoredBy="//@regions.1/@sensors.1 //@regions.1/@sensors.2 //@regions.1/@sensors.4 //@regions.1/@sensors.0" connectsTo="//@regions.1/@elements.5 //@regions.1/@elements.0 //@regions.1/@elements.1" currentPosition="DIVERGING"/>
    <elements xsi:type="Segment" connectsTo="//@regions.1/@elements.2 //@regions.1/@elements.1" length="-1"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.3" connectsTo="//@regions.1/@elements.2" length="35"/>
