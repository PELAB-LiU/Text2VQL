<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes requires="//@regions.2/@sensors.2 //@regions.1/@sensors.0 //@regions.2/@sensors.1 //@regions.1/@sensors.1" entry="//@regions.1/@elements.3/@semaphores.0" exit="//@regions.1/@elements.3/@semaphores.0">
    <follows position="DIVERGING" target="//@regions.1/@elements.2"/>
  </routes>
  <regions>
    <elements xsi:type="Segment"/>
  </regions>
  <regions>
    <sensors monitors="//@regions.1/@elements.2 //@regions.1/@elements.3 //@regions.1/@elements.1"/>
    <sensors monitors="//@regions.1/@elements.3 //@regions.1/@elements.2 //@regions.1/@elements.1"/>
    <sensors monitors="//@regions.1/@elements.2 //@regions.1/@elements.1"/>
    <sensors monitors="//@regions.1/@elements.2"/>
    <elements xsi:type="Segment" connectsTo="//@regions.1/@elements.1 //@regions.2/@elements.0" length="-5"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.2/@sensors.1 //@regions.2/@sensors.0 //@regions.1/@sensors.2 //@regions.1/@sensors.0 //@regions.1/@sensors.1" length="95"/>
    <elements xsi:type="Switch" monitoredBy="//@regions.1/@sensors.0 //@regions.2/@sensors.1 //@regions.1/@sensors.3 //@regions.1/@sensors.2 //@regions.1/@sensors.1" connectsTo="//@regions.1/@elements.1" currentPosition="STRAIGHT" positions="//@routes.0/@follows.0"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.0 //@regions.2/@sensors.1 //@regions.1/@sensors.1 //@regions.2/@sensors.2" connectsTo="//@regions.1/@elements.1 //@regions.1/@elements.2">
      <semaphores signal="STOP"/>
    </elements>
  </regions>
  <regions>
    <sensors monitors="//@regions.1/@elements.1"/>
    <sensors monitors="//@regions.1/@elements.1 //@regions.1/@elements.2 //@regions.1/@elements.3"/>
    <sensors monitors="//@regions.1/@elements.3"/>
    <elements xsi:type="Segment" length="21"/>
  </regions>
</RailwayContainer>
