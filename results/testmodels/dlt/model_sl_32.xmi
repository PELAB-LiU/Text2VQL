<?xml version="1.0" encoding="ASCII"?>
<dlt:RaftFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode"/>
    </hosts>
  </organizations>
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.1/@chaincodes.0 //@channels.1/@chaincodes.1 //@channels.1/@chaincodes.3"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.1/@chaincodes.1 //@channels.1/@chaincodes.0 //@channels.1/@chaincodes.3"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.1/@chaincodes.3"/>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.0 //@channels.1"/>
    </hosts>
  </organizations>
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode"/>
    </hosts>
  </organizations>
  <channels orderedBy="//@organizations.1/@hosts.0/@nodes.3">
    <chaincodes/>
  </channels>
  <channels orderedBy="//@organizations.1/@hosts.0/@nodes.3">
    <chaincodes endorsedBy="//@organizations.1/@hosts.0/@nodes.0 //@organizations.1/@hosts.0/@nodes.1"/>
    <chaincodes endorsedBy="//@organizations.1/@hosts.0/@nodes.1 //@organizations.1/@hosts.0/@nodes.0"/>
    <chaincodes/>
    <chaincodes endorsedBy="//@organizations.1/@hosts.0/@nodes.2 //@organizations.1/@hosts.0/@nodes.0 //@organizations.1/@hosts.0/@nodes.1"/>
  </channels>
</dlt:RaftFabricNetwork>
