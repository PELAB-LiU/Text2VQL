  <routes active="true" requires="//@regions.2/@sensors.0 //@regions.1/@sensors.1 //@regions.1/@sensors.2" entry="//@regions.2/@elements.1/@semaphores.0" exit="//@regions.2/@elements.1/@semaphores.0">
