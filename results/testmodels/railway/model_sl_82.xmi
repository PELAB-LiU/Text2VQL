<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes requires="//@regions.1/@sensors.2" entry="//@regions.1/@elements.1/@semaphores.0" exit="//@regions.1/@elements.1/@semaphores.0">
    <follows position="DIVERGING" target="//@regions.0/@elements.0"/>
  </routes>
  <regions>
    <sensors monitors="//@regions.0/@elements.0"/>
    <elements xsi:type="Switch" monitoredBy="//@regions.1/@sensors.3 //@regions.0/@sensors.0" connectsTo="//@regions.1/@elements.1" positions="//@routes.0/@follows.0"/>
    <elements xsi:type="Segment" connectsTo="//@regions.1/@elements.0 //@regions.1/@elements.1" length="-4"/>
    <elements xsi:type="Segment" connectsTo="//@regions.0/@elements.3" length="94"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.2"/>
  </regions>
  <regions>
    <sensors/>
    <sensors/>
    <sensors monitors="//@regions.0/@elements.3 //@regions.1/@elements.1"/>
    <sensors monitors="//@regions.0/@elements.0 //@regions.1/@elements.1"/>
    <elements xsi:type="Segment" connectsTo="//@regions.0/@elements.2 //@regions.1/@elements.1" length="-9"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.3 //@regions.1/@sensors.2" connectsTo="//@regions.0/@elements.0 //@regions.0/@elements.1">
      <semaphores signal="GO"/>
    </elements>
  </regions>
</RailwayContainer>
