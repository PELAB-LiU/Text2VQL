<?xml version="1.0" encoding="ASCII"?>
<dlt:RaftFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations/>
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode"/>
      <nodes xsi:type="dlt:OrderingNode"/>
    </hosts>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.2/@chaincodes.1 //@channels.2/@chaincodes.3 //@channels.2/@chaincodes.2"/>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.1 //@channels.0"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.2/@chaincodes.1 //@channels.2/@chaincodes.2 //@channels.2/@chaincodes.0"/>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.2"/>
    </hosts>
    <hosts/>
  </organizations>
  <channels orderedBy="//@organizations.1/@hosts.1/@nodes.1">
    <chaincodes/>
  </channels>
  <channels orderedBy="//@organizations.1/@hosts.1/@nodes.1"/>
  <channels orderedBy="//@organizations.1/@hosts.1/@nodes.3">
    <chaincodes endorsedBy="//@organizations.1/@hosts.1/@nodes.2"/>
    <chaincodes endorsedBy="//@organizations.1/@hosts.1/@nodes.0 //@organizations.1/@hosts.1/@nodes.2"/>
    <chaincodes endorsedBy="//@organizations.1/@hosts.1/@nodes.2 //@organizations.1/@hosts.1/@nodes.0"/>
    <chaincodes endorsedBy="//@organizations.1/@hosts.1/@nodes.0"/>
  </channels>
</dlt:RaftFabricNetwork>
