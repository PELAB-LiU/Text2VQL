<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes requires="//@regions.0/@sensors.0 //@regions.1/@sensors.3" entry="//@regions.0/@elements.1/@semaphores.0" exit="//@regions.0/@elements.1/@semaphores.0">
    <follows position="STRAIGHT" target="//@regions.0/@elements.0"/>
  </routes>
  <regions>
    <sensors monitors="//@regions.0/@elements.3 //@regions.0/@elements.0"/>
    <elements xsi:type="Switch" monitoredBy="//@regions.1/@sensors.1 //@regions.0/@sensors.0" connectsTo="//@regions.1/@elements.1 //@regions.0/@elements.3 //@regions.0/@elements.1" currentPosition="STRAIGHT" positions="//@routes.0/@follows.0"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.1 //@regions.1/@sensors.3" connectsTo="//@regions.0/@elements.0" length="-9">
      <semaphores signal="GO"/>
    </elements>
    <elements xsi:type="Segment"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.2 //@regions.0/@sensors.0" length="-1"/>
  </regions>
  <regions>
    <sensors/>
    <sensors monitors="//@regions.0/@elements.0 //@regions.0/@elements.1"/>
    <sensors monitors="//@regions.0/@elements.3 //@regions.1/@elements.0 //@regions.1/@elements.1"/>
    <sensors monitors="//@regions.0/@elements.1"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.2" connectsTo="//@regions.0/@elements.0" length="-7"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.2" connectsTo="//@regions.0/@elements.0" length="40"/>
  </regions>
</RailwayContainer>
