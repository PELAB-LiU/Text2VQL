<?xml version="1.0" encoding="ASCII"?>
<dlt:RaftFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations/>
  <organizations/>
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.2/@chaincodes.0 //@channels.2/@chaincodes.2"/>
      <nodes xsi:type="dlt:EndorsingNode"/>
    </hosts>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.2/@chaincodes.3 //@channels.2/@chaincodes.2"/>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.2"/>
    </hosts>
  </organizations>
  <channels/>
  <channels>
    <chaincodes/>
    <chaincodes/>
  </channels>
  <channels orderedBy="//@organizations.2/@hosts.1/@nodes.1">
    <chaincodes endorsedBy="//@organizations.2/@hosts.0/@nodes.1"/>
    <chaincodes/>
    <chaincodes endorsedBy="//@organizations.2/@hosts.1/@nodes.0 //@organizations.2/@hosts.0/@nodes.1"/>
    <chaincodes endorsedBy="//@organizations.2/@hosts.1/@nodes.0"/>
  </channels>
</dlt:RaftFabricNetwork>
