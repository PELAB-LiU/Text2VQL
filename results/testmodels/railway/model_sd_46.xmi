    <elements xsi:type="Segment" monitoredBy="//@regions.3/@sensors.4 //@regions.3/@sensors.2 //@regions.1/@sensors.2 //@regions.3/@sensors.1 //@regions.3/@sensors.5 //@regions.1/@sensors.1" connectsTo="//@regions.3/@elements.3 //@regions.3/@elements.2" length="-2">
