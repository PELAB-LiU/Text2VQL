<?xml version="1.0" encoding="ASCII"?>
<dlt:KafkaFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations/>
  <organizations/>
  <organizations/>
  <organizations>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode"/>
      <nodes xsi:type="dlt:OrderingNode"/>
    </hosts>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode"/>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.0"/>
    </hosts>
    <hosts>
      <nodes xsi:type="dlt:EndorsingNode"/>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.1 //@channels.2"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.2/@chaincodes.0 //@channels.1/@chaincodes.0"/>
    </hosts>
  </organizations>
  <channels orderedBy="//@organizations.3/@hosts.1/@nodes.1"/>
  <channels orderedBy="//@organizations.3/@hosts.2/@nodes.1">
    <chaincodes endorsedBy="//@organizations.3/@hosts.2/@nodes.2"/>
  </channels>
  <channels orderedBy="//@organizations.3/@hosts.2/@nodes.1">
    <chaincodes endorsedBy="//@organizations.3/@hosts.2/@nodes.2"/>
  </channels>
</dlt:KafkaFabricNetwork>
