<?xml version="1.0" encoding="ASCII"?>
<dlt:KafkaFabricNetwork xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dlt="http://pelab.liu.se/text2vql/dlt">
  <organizations>
    <hosts/>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode"/>
    </hosts>
    <hosts>
      <nodes xsi:type="dlt:OrderingNode" orders="//@channels.3 //@channels.2"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.2/@chaincodes.0 //@channels.3/@chaincodes.0"/>
      <nodes xsi:type="dlt:EndorsingNode" endorses="//@channels.3/@chaincodes.0"/>
    </hosts>
  </organizations>
  <channels/>
  <channels>
    <chaincodes/>
  </channels>
  <channels orderedBy="//@organizations.0/@hosts.2/@nodes.0">
    <chaincodes endorsedBy="//@organizations.0/@hosts.2/@nodes.1"/>
    <chaincodes/>
    <chaincodes/>
    <chaincodes/>
  </channels>
  <channels orderedBy="//@organizations.0/@hosts.2/@nodes.0">
    <chaincodes endorsedBy="//@organizations.0/@hosts.2/@nodes.2 //@organizations.0/@hosts.2/@nodes.1"/>
    <chaincodes/>
  </channels>
</dlt:KafkaFabricNetwork>
