<?xml version="1.0" encoding="ASCII"?>
<RailwayContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="railway">
  <routes requires="//@regions.1/@sensors.1" entry="//@regions.1/@elements.0/@semaphores.0" exit="//@regions.1/@elements.0/@semaphores.0">
    <follows position="DIVERGING" target="//@regions.0/@elements.0"/>
  </routes>
  <regions>
    <sensors/>
    <sensors monitors="//@regions.1/@elements.2 //@regions.1/@elements.0"/>
    <elements xsi:type="Switch" monitoredBy="//@regions.1/@sensors.2" currentPosition="STRAIGHT" positions="//@routes.0/@follows.0"/>
  </regions>
  <regions>
    <sensors/>
    <sensors monitors="//@regions.1/@elements.0"/>
    <sensors monitors="//@regions.1/@elements.0 //@regions.1/@elements.3 //@regions.0/@elements.0"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.2 //@regions.1/@sensors.1 //@regions.0/@sensors.1" connectsTo="//@regions.3/@elements.0 //@regions.1/@elements.2" length="-10">
      <semaphores signal="STOP"/>
    </elements>
    <elements xsi:type="Segment"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.0/@sensors.1"/>
    <elements xsi:type="Segment" monitoredBy="//@regions.1/@sensors.2" length="54"/>
  </regions>
  <regions/>
  <regions>
    <elements xsi:type="Segment" connectsTo="//@regions.1/@elements.1"/>
  </regions>
</RailwayContainer>
